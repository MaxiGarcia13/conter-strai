---
import SiteTopbar from '@/components/site-topbar.astro';
import BaseLayout from '@/layouts/base-layout.astro';
import { CreateRoomForm } from '@/modules/lobby/components/create-room-form';
---

<BaseLayout
  title="Create Room — Conter Strai"
  description="Create a room, pick your team and character, and invite friends to play."
>
  <section class="relative z-10 flex min-h-dvh flex-col">
    <SiteTopbar title="Create Room">
      <a
        slot="leading"
        href="/"
        class="hover:text-accent focus-visible:outline-accent motion-safe:transition-colors focus-visible:outline-2 focus-visible:outline-offset-4"
      >
        ← Home
      </a>
    </SiteTopbar>

    <div class="flex flex-1 flex-col px-(--space-page-x) py-(--space-page-y)">
      <CreateRoomForm client:only="react" />
    </div>
  </section>
</BaseLayout>
