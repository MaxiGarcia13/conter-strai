---
const bullets = [
  'Online PvP combat',
  'Fast tactical rounds',
  'Runs in your browser — no install',
];
---

<section class="relative z-10 flex min-h-dvh flex-col">
  <div
    class="font-mono text-foreground-muted flex items-center justify-between gap-4 border-b border-surface-border/80 px-(--space-page-x) py-3 text-xs tracking-[0.2em] uppercase"
  >
    <p class="flex items-center gap-2 text-accent">
      <span
        class="motion-safe:animate-pulse size-1.5 shrink-0 rounded-full bg-accent"
        aria-hidden="true"
      ></span>
      Live
    </p>
    <p>
      <span class="text-foreground">Argentina</span>
      <span class="text-accent mx-2">vs</span>
      <span class="text-foreground">England</span>
    </p>
    <p class="hidden sm:block">Browser client</p>
  </div>

  <div
    class="grid flex-1 items-center gap-12 px-(--space-page-x) py-(--space-page-y) lg:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)] lg:gap-16"
  >
    <div class="hud-corners p-5 sm:p-8">
      <p class="font-mono text-accent text-xs tracking-[0.32em] uppercase">
        // Tactical shooter
      </p>
      <h1
        class="font-display mt-3 text-[clamp(3.25rem,12vw,7.25rem)] leading-[0.85] font-extrabold tracking-[0.06em] text-foreground uppercase"
      >
        Conter <span class="text-accent">Strai</span>
      </h1>
      <p
        class="text-foreground-muted mt-5 max-w-prose text-lg font-medium tracking-wide sm:text-xl"
      >
        Lock in, squad up, and hold the line.
      </p>

      <ul class="mt-8 space-y-0 border-t border-surface-border">
        {
          bullets.map((bullet, index) => (
            <li class="text-foreground-muted flex items-center gap-4 border-b border-surface-border py-3 text-base font-medium tracking-wide">
              <span class="font-mono text-accent w-8 shrink-0 text-xs tracking-widest">
                {String(index + 1).padStart(2, '0')}
              </span>
              {bullet}
            </li>
          ))
        }
      </ul>

      <a href="/play" class="cs-cta motion-safe:transition-[background-color,box-shadow] mt-10">
        <svg class="size-3 fill-current" viewBox="0 0 12 12" aria-hidden="true">
          <path d="M2 1.2v9.6L11 6 2 1.2z"></path>
        </svg>
        Start Game
      </a>
    </div>

    <div class="hero-art-grid relative flex items-center justify-center">
      <div
        class="bg-accent/25 pointer-events-none absolute inset-[18%] rounded-full blur-3xl"
        aria-hidden="true"
      >
      </div>
      <img
        src="/soldiers.png"
        alt="Soldiers geared up for deployment"
        class="relative z-10 mx-auto max-h-[min(70vh,40rem)] w-auto object-contain drop-shadow-2xl"
        loading="eager"
        decoding="async"
      />
    </div>
  </div>
</section>
