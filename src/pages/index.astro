---
import BaseLayout from '@/layouts/base-layout.astro';
import LandingHero from '@/modules/landing/components/LandingHero.astro';

const title = 'Conter Strai';
const description =
  'Lock in, squad up, and hold the line. Conter Strai is an online PvP tactical shooter that runs in your browser.';
---

<BaseLayout
  title={title}
  description={description}
  image="/soldiers.png"
  imageAlt="Soldiers geared up for deployment"
>
  <LandingHero />
</BaseLayout>
