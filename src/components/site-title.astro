---
interface Props {
  size?: 'hero' | 'default';
  leading?: string;
  accent?: string;
}

const { size = 'default', leading, accent } = Astro.props;

const sizeClasses =
  size === 'hero'
    ? 'text-[clamp(3.25rem,12vw,7.25rem)] leading-[0.85]'
    : 'text-[clamp(2.5rem,8vw,4.5rem)] leading-[0.9]';
---

<h1 class:list={['font-display mt-3 font-extrabold tracking-[0.06em] text-foreground uppercase', sizeClasses]}>
  {leading}
  {accent && <span class="text-accent">{accent}</span>}
  <slot />
</h1>
