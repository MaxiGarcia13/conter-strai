---
import PlayLoader from '@/components/play-loader.astro';
import BaseLayout from '@/layouts/base-layout.astro';
import { GameCanvasIsland } from '@/modules/game/components/game-canvas-island';
import { MatchJoinError } from '@/modules/multiplayer/components/match-join-error';

const { roomId } = Astro.params;
---

<BaseLayout
  title="Play — Conter Strai"
  description="Deploy into the arena. Move fast, hold angles, win the round."
>
  <main class="fixed inset-0 z-10 bg-black">
    <PlayLoader />

    {
      roomId ? (
        <GameCanvasIsland client:only="react" roomId={roomId} />
      ) : (
        <MatchJoinError client:only="react" message="Room not found" />
      )
    }

    <noscript>
      <p
        class="font-mono text-foreground flex h-dvh items-center justify-center text-center text-sm tracking-widest uppercase"
      >
        Conter Strai needs JavaScript to run.
      </p>
    </noscript>
  </main>
</BaseLayout>
