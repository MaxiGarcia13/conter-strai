---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  type?: 'button' | 'submit' | 'reset';
  class?: string;
  showIcon?: boolean;
}

const {
  href,
  variant = 'primary',
  type = 'button',
  class: className,
  showIcon = true,
} = Astro.props;

const Tag = href ? 'a' : 'button';
---

<Tag
  class:list={['cs-button', `cs-button--${variant}`, className]}
  href={href}
  type={href ? undefined : type}
>
  {
    showIcon && (
      <svg
        class="cs-button__icon"
        viewBox="0 0 12 12"
        aria-hidden="true"
      >
        <path d="M2 1.2v9.6L11 6 2 1.2z"></path>
      </svg>
    )
  }
  <span class="cs-button__label"><slot /></span>
</Tag>
