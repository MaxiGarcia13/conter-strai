{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    ".cursor/rules/*.md",
    ".cursor/rules/*.mdc"
  ],
  "skills": {
    "paths": [
      ".cursor/skills"
    ]
  },
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    }
  }
}
