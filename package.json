{
  "name": "conter-strai",
  "type": "module",
  "version": "0.0.0",
  "description": "Shooter game",
  "author": "Maximiliano Garcia Mortigliengo",
  "license": "ISC",
  "homepage": "https://github.com/MaxiGarcia13/conter-strai#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaxiGarcia13/conter-strai.git"
  },
  "bugs": {
    "url": "https://github.com/MaxiGarcia13/conter-strai/issues"
  },
  "scripts": {
    "prepare": "simple-git-hooks || true",
    "dev": "astro dev",
    "build": "astro build",
    "assets:compress": "node scripts/compress-assets.mjs",
    "assets:normalize-characters": "node scripts/normalize-character-glbs.mjs",
    "assets:extract-maps": "node scripts/extract-texture-maps.mjs",
    "preview": "astro preview",
    "clean": "rm -rf node_modules && rm -rf dist && rm -rf .astro",
    "phoenix": "npm run clean && npm i",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "PORT=4326 E2E=true playwright test",
    "test:e2e:ui": "PORT=4326 E2E=true playwright test --ui --headed",
    "lint": "eslint .",
    "lint:fix": "eslint --fix ."
  },
  "dependencies": {
    "@astrojs/node": "^11.1.4",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "three": "^0.185.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@astrojs/react": "^6.0.2",
    "@astrojs/sitemap": "^3.7.3",
    "@eslint-react/eslint-plugin": "^3.0.0",
    "@gltf-transform/core": "^4.4.2",
    "@gltf-transform/extensions": "^4.4.2",
    "@maxigarcia/eslint-config": "^1.8.0",
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "draco3dgltf": "^1.5.7",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-react-refresh": "^0.5.3",
    "lint-staged": "^17.3.0",
    "simple-git-hooks": "^2.13.1",
    "vitest": "^4.1.10"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,md,astro}": "eslint --fix"
  }
}
