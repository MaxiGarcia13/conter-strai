---
import csImg from '@assets/images/cs.png';
import { getImage, Image } from 'astro:assets';
import CsButton from '@/components/cs-button.astro';
import SiteTopbar from '@/components/site-topbar.astro';
import BaseLayout from '@/layouts/base-layout.astro';

const ogImage = await getImage({
  src: csImg,
  width: 1200,
  height: 800,
  format: 'png',
});

const title = 'Conter Strai';
const description
  = 'The revolution starts here — choose Civilians or Soldiers. Conter Strai is an online PvP tactical shooter that runs in your browser.';
const bullets = [
  'Online PvP combat',
  'Fast tactical rounds',
  'Runs in your browser — no install',
];
---

<BaseLayout
  title={title}
  description={description}
  image={ogImage.src}
  imageAlt="Soldiers geared up for deployment"
>
  <link
    slot="head"
    rel="preload"
    href="/fonts/Barlow_Condensed/BarlowCondensed-ExtraBold.woff2"
    as="font"
    type="font/woff2"
    crossorigin
  />
  <section class="relative flex flex-1 flex-col">
    <SiteTopbar>
      <p slot="leading" class="flex items-center gap-2 text-accent">
        <span
          class="motion-safe:animate-pulse size-1.5 shrink-0 rounded-full bg-accent"
          aria-hidden="true"
        ></span>
        Live
      </p>
      <p slot="center">
        <span class="text-foreground">Civilians</span>
        <span class="text-accent mx-2">vs</span>
        <span class="text-foreground">Soldiers</span>
      </p>
    </SiteTopbar>

    <div
      class="grid flex-1 items-center gap-12 px-(--space-page-x) py-(--space-page-y) lg:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)] lg:gap-16"
    >
      <div class="hud-corners p-5 sm:p-8">
        <p class="font-mono text-accent text-xs tracking-[0.32em] uppercase">
          // Tactical shooter
        </p>
        <h1
          class="font-display mt-3 text-[clamp(3.25rem,12vw,7.25rem)] leading-[0.85] font-extrabold tracking-[0.06em] text-foreground uppercase"
        >
          Conter <span class="text-accent">Strai</span>
        </h1>
        <p
          class="text-foreground-muted mt-5 max-w-prose text-lg font-medium tracking-wide sm:text-xl"
        >
          The revolution starts here — choose your side and fight.
        </p>

        <ul class="mt-8 space-y-0 border-t border-surface-border">
          {
            bullets.map((bullet, index) => (
              <li class="text-foreground-muted flex items-center gap-4 border-b border-surface-border py-3 text-base font-medium tracking-wide">
                <span class="font-mono text-accent w-8 shrink-0 text-xs tracking-widest">
                  {String(index + 1).padStart(2, '0')}
                </span>
                {bullet}
              </li>
            ))
          }
        </ul>

        <div class="mt-10 flex flex-wrap items-center gap-4">
          <CsButton href="/room" variant="primary">Create Room</CsButton>
          <CsButton href="/room/join" variant="secondary">Join Room</CsButton>
        </div>
      </div>

      <div class="hero-art-grid relative flex items-center justify-center">
        <div
          class="bg-accent/25 pointer-events-none absolute inset-[18%] rounded-full blur-3xl"
          aria-hidden="true"
        >
        </div>
        <Image
          src={csImg}
          alt="Soldiers geared up for deployment"
          widths={[256, 480, 768]}
          sizes="(max-width: 1024px) 90vw, 960px"
          class="relative z-10 mx-auto h-auto max-h-[min(70vh,40rem)] w-auto object-contain drop-shadow-2xl"
          loading="eager"
          decoding="async"
        />
      </div>
    </div>
  </section>
</BaseLayout>
