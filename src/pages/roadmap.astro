---
import { readFile } from 'node:fs/promises';
import path from 'node:path';
import { getEntry, render } from 'astro:content';
import SitePageHeader from '@/components/site-page-header.astro';
import SitePage from '@/components/site-page.astro';
import SitePanel from '@/components/site-panel.astro';
import BaseLayout from '@/layouts/base-layout.astro';
import { parseShippedUserStories } from '@/utils/parse-changelog-shipped';
import { specDocUrl } from '@/utils/spec-doc-links';
import '@/styles/roadmap-prose.css';

const title = 'Roadmap — Conter Strai';
const description =
  'What is next for Conter Strai — open work from specs/current/tasks.md and recently shipped user stories.';

const tasksEntry = await getEntry('specs', 'current/tasks');
if (!tasksEntry) {
  throw new Error('Missing specs/current/tasks.md content entry');
}

const { Content: TasksContent } = await render(tasksEntry);

const changelogPath = path.join(process.cwd(), 'specs/CHANGELOG.md');
const changelog = await readFile(changelogPath, 'utf8');
const recentlyShipped = parseShippedUserStories(changelog);

const contributorDocs = [
  { label: 'Design (current)', href: specDocUrl('current/design.md') },
  {
    label: 'Requirements (current)',
    href: specDocUrl('current/requirements.md'),
  },
  { label: 'Tasks (current)', href: specDocUrl('current/tasks.md') },
  { label: 'Full changelog', href: specDocUrl('CHANGELOG.md') },
];
---

<BaseLayout title={title} description={description}>
  <SitePage topbarTitle="Roadmap" showBackHome narrow>
    <SitePageHeader eyebrow="Project status" accent="Roadmap">
      Live view of the work queue and recent releases — sourced from

      <code class="text-foreground text-sm mx-1">specs/</code>

      at build time.
    </SitePageHeader>

    <div class="mt-10 space-y-10">
      <SitePanel title="What’s next">
        <p slot="description">
          From <code class="text-foreground">specs/current/tasks.md</code> — suggested order and open work below.
        </p>
        <article class="roadmap-prose roadmap-tasks mt-4">
          <TasksContent />
        </article>
      </SitePanel>

      <SitePanel title="Recently shipped">
        <p slot="description">
          Last five user stories from
          <a href={specDocUrl('CHANGELOG.md')} class="site-inline-link" target="_blank" rel="noopener noreferrer">
            CHANGELOG.md
          </a>.
        </p>
        {
          recentlyShipped.length > 0 ? (
            <div class="mt-4 overflow-x-auto">
              <table class="roadmap-shipped-table">
                <thead>
                  <tr>
                    <th scope="col">US</th>
                    <th scope="col">Summary</th>
                  </tr>
                </thead>
                <tbody>
                  {recentlyShipped.map(({ us, summary }) => (
                    <tr>
                      <td>{us}</td>
                      <td>{summary}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          ) : (
            <p class="text-foreground-muted mt-4 text-sm">No shipped entries found.</p>
          )
        }
      </SitePanel>

      <SitePanel title="Full docs">
        <p slot="description">For contributors — complete specs live in the repository.</p>
        <nav class="roadmap-doc-links mt-4" aria-label="Contributor documentation">
          {
            contributorDocs.map(({ label, href }) => (
              <a href={href} target="_blank" rel="noopener noreferrer">
                {label}
              </a>
            ))
          }
        </nav>
      </SitePanel>
    </div>
  </SitePage>
</BaseLayout>
