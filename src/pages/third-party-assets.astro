---
import BackHomeLink from '@/components/back-home-link.astro';
import SiteEyebrow from '@/components/site-eyebrow.astro';
import SitePanel from '@/components/site-panel.astro';
import SiteTitle from '@/components/site-title.astro';
import SiteTopbar from '@/components/site-topbar.astro';
import BaseLayout from '@/layouts/base-layout.astro';

const title = 'Credits — Conter Strai';
const description =
  'Third-party assets used in Conter Strai — Poly Haven textures and models, Mixamo characters and animation, and Tabler Icons.';

const polyHavenTextures = [
  'Asphalt',
  'Brown floor tiles',
  'Broken brick',
  'Castle brick broken',
  'Cliff side',
  'Forest ground',
];

const polyHavenModels = ['Covered car', 'Concrete road barrier', 'Jacaranda tree', 'Pistol'];

const mixamoCharacters = ['James, Liza, Remy (civilians)', 'SWAT 1–3 (soldiers)'];

const mixamoAnimations = ['Idle, walk, run, and combat locomotion', 'Aim, crouch, death, and hit reactions'];

const tablerIcons = ['Arrow down', 'Arrow left (back)', 'Brand GitHub', 'Caret right', 'Flame', 'Menu', 'Run'];

const externalTitleLinkClass =
  'hover:text-accent focus-visible:outline-accent underline-offset-4 motion-safe:transition-colors hover:underline focus-visible:outline-2 focus-visible:outline-offset-4';
---

<BaseLayout title={title} description={description}>
  <section class="relative flex flex-1 flex-col">
    <SiteTopbar title="Credits">
      <BackHomeLink slot="leading" />
    </SiteTopbar>

    <div class="flex flex-1 flex-col px-(--space-page-x) py-(--space-page-y)">
      <div class="mx-auto w-full max-w-3xl">
        <SiteEyebrow text="Attributions" />
        <SiteTitle leading="Third-party " accent="assets" />
        <p class="text-foreground-muted mt-4 max-w-prose text-lg font-medium tracking-wide">
          Conter Strai is built with open assets from the community. Thank you to the artists and maintainers below.
        </p>

        <div class="mt-10 space-y-8">
          <SitePanel as="article" descriptionSize="base">
            <a
              slot="title"
              href="https://polyhaven.com/"
              class={externalTitleLinkClass}
              target="_blank"
              rel="noopener noreferrer"
            >
              Poly Haven
            </a>
            <p slot="description">
              PBR textures and 3D models from
              <a
                href="https://polyhaven.com/"
                class="text-accent hover:underline"
                target="_blank"
                rel="noopener noreferrer"
              >
                polyhaven.com
              </a>
              — CC0, free for any use.
            </p>

            <div class="mt-5 grid gap-6 sm:grid-cols-2">
              <div>
                <h3 class="font-mono text-accent text-xs tracking-[0.24em] uppercase">Textures</h3>
                <ul class="text-foreground-muted mt-3 space-y-2 text-sm leading-relaxed">
                  {polyHavenTextures.map((item) => <li class="border-b border-surface-border/60 pb-2">{item}</li>)}
                </ul>
              </div>
              <div>
                <h3 class="font-mono text-accent text-xs tracking-[0.24em] uppercase">Models</h3>
                <ul class="text-foreground-muted mt-3 space-y-2 text-sm leading-relaxed">
                  {polyHavenModels.map((item) => <li class="border-b border-surface-border/60 pb-2">{item}</li>)}
                </ul>
              </div>
            </div>
          </SitePanel>

          <SitePanel as="article" descriptionSize="base">
            <a
              slot="title"
              href="https://www.mixamo.com/"
              class={externalTitleLinkClass}
              target="_blank"
              rel="noopener noreferrer"
            >
              Mixamo
            </a>
            <p slot="description">
              Character meshes and skeletal animation from
              <a
                href="https://www.mixamo.com/"
                class="text-accent hover:underline"
                target="_blank"
                rel="noopener noreferrer"
              >
                mixamo.com
              </a>
              (Adobe). Used under the Mixamo terms of use.
            </p>

            <div class="mt-5 grid gap-6 sm:grid-cols-2">
              <div>
                <h3 class="font-mono text-accent text-xs tracking-[0.24em] uppercase">Characters</h3>
                <ul class="text-foreground-muted mt-3 space-y-2 text-sm leading-relaxed">
                  {mixamoCharacters.map((item) => <li class="border-b border-surface-border/60 pb-2">{item}</li>)}
                </ul>
              </div>
              <div>
                <h3 class="font-mono text-accent text-xs tracking-[0.24em] uppercase">Animation</h3>
                <ul class="text-foreground-muted mt-3 space-y-2 text-sm leading-relaxed">
                  {mixamoAnimations.map((item) => <li class="border-b border-surface-border/60 pb-2">{item}</li>)}
                </ul>
              </div>
            </div>
          </SitePanel>

          <SitePanel as="article" descriptionSize="base">
            <a
              slot="title"
              href="https://tabler.io/icons"
              class={externalTitleLinkClass}
              target="_blank"
              rel="noopener noreferrer"
            >
              Tabler Icons
            </a>
            <p slot="description">
              UI icons from
              <a
                href="https://tabler.io/"
                class="text-accent hover:underline"
                target="_blank"
                rel="noopener noreferrer"
              >
                tabler.io
              </a>
              — MIT license.
            </p>

            <h3 class="font-mono text-accent mt-5 text-xs tracking-[0.24em] uppercase">Icons in use</h3>
            <ul class="text-foreground-muted mt-3 columns-1 gap-x-8 space-y-2 text-sm leading-relaxed sm:columns-2">
              {
                tablerIcons.map((item) => (
                  <li class="border-b border-surface-border/60 pb-2 break-inside-avoid">{item}</li>
                ))
              }
            </ul>
          </SitePanel>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
