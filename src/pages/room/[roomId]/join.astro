---
import SitePage from '@/components/site-page.astro';
import BaseLayout from '@/layouts/base-layout.astro';
import { JoinRoomForm } from '@/modules/lobby/components/join-room-form';

const roomId = Astro.params.roomId;
if (!roomId) return Astro.redirect('/room/join');
---

<BaseLayout title={`Join ${roomId} — Conter Strai`} description='Pick your team and character, then join the match.'>
  <SitePage topbarTitle='Join Room' showBackHome>
    <JoinRoomForm roomId={roomId} client:only='react' />
  </SitePage>
</BaseLayout>
