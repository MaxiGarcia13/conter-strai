---
import SiteTopbar from '@/components/site-topbar.astro';
import BaseLayout from '@/layouts/base-layout.astro';
import { WaitingRoom } from '@/modules/lobby/components/waiting-room';

const { roomId } = Astro.params;
if (!roomId)
  return Astro.redirect('/');
---

<BaseLayout
  title={`Room ${roomId} — Conter Strai`}
  description="Waiting room — invite friends and start the match."
>
  <section class="relative z-10 flex min-h-dvh flex-col">
    <SiteTopbar title="Waiting Room">
      <a
        slot="leading"
        href="/"
        class="hover:text-accent focus-visible:outline-accent motion-safe:transition-colors focus-visible:outline-2 focus-visible:outline-offset-4"
      >
        ← Home
      </a>
    </SiteTopbar>

    <div class="flex flex-1 flex-col px-(--space-page-x) py-(--space-page-y)">
      <WaitingRoom client:only="react" roomId={roomId} />
    </div>
  </section>
</BaseLayout>
