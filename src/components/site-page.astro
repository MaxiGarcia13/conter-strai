---
import BackHomeLink from '@/components/back-home-link.astro';
import SiteTopbar from '@/components/site-topbar.astro';

interface Props {
  topbarTitle?: string;
  showBackHome?: boolean;
  narrow?: boolean;
}

const { topbarTitle, showBackHome = false, narrow = false } = Astro.props;
---

<section class='relative flex flex-1 flex-col'>
  <SiteTopbar title={topbarTitle}>
    {
      Astro.slots.has('topbar-leading') ? (
        <slot name='topbar-leading' slot='leading' />
      ) : showBackHome ? (
        <BackHomeLink slot='leading' />
      ) : null
    }
    {Astro.slots.has('topbar-center') && <slot name='topbar-center' slot='center' />}
    {Astro.slots.has('topbar-trailing') && <slot name='topbar-trailing' slot='trailing' />}
  </SiteTopbar>

  <div class='flex flex-1 flex-col px-(--space-page-x) py-(--space-page-y)'>
    {
      narrow ? (
        <div class='mx-auto w-full max-w-3xl'>
          <slot />
        </div>
      ) : (
        <slot />
      )
    }
  </div>
</section>
