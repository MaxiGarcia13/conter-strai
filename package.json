{
  "name": "conter-strai",
  "type": "module",
  "version": "0.9.0",
  "description": "Browser tactical shooter — Civilians vs Soldiers, round-based team elimination. Astro, React Three Fiber, and Colyseus.",
  "author": "Maximiliano Garcia Mortigliengo",
  "license": "ISC",
  "homepage": "https://github.com/MaxiGarcia13/conter-strai#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaxiGarcia13/conter-strai.git"
  },
  "bugs": {
    "url": "https://github.com/MaxiGarcia13/conter-strai/issues"
  },
  "keywords": [
    "tactical-shooter",
    "browser-game",
    "web-game",
    "fps",
    "pvp",
    "multiplayer",
    "team-deathmatch",
    "round-based",
    "astro",
    "react-three-fiber",
    "react",
    "threejs",
    "colyseus",
    "open-source"
  ],
  "scripts": {
    "prepare": "husky || true",
    "dev": "astro dev",
    "build": "astro build && node scripts/build-server-entry.mjs",
    "preview": "node dist/server/custom-entry.mjs",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "PORT=4326 PUBLIC_E2E=true COLYSEUS_PORT=2568 PUBLIC_COLYSEUS_URL=ws://localhost:2568 playwright test -x",
    "test:e2e:ui": "npm run test:e2e -- --ui --headed",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "assets:compress": "node scripts/compress-assets.mjs",
    "assets:normalize-characters": "node scripts/normalize-character-glbs.mjs",
    "assets:snap-animation-floor": "node scripts/snap-animation-floor.mjs",
    "assets:extract-maps": "node scripts/extract-texture-maps.mjs",
    "clean": "rm -rf node_modules && rm -rf dist && rm -rf .astro",
    "phoenix": "npm run clean && npm i"
  },
  "dependencies": {
    "@colyseus/schema": "^5.0.20",
    "@colyseus/sdk": "^0.18.2",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@tanstack/react-query": "^5.102.6",
    "astro": "^7.2.10",
    "colyseus": "^0.18.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-qr-code": "^2.2.0",
    "three": "^0.185.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@astrojs/markdown-satteri": "^0.4.0",
    "@astrojs/node": "^11.1.5",
    "@astrojs/react": "^6.0.5",
    "@astrojs/sitemap": "^3.7.4",
    "@eslint-react/eslint-plugin": "^5.18.6",
    "@gltf-transform/core": "^4.4.2",
    "@gltf-transform/extensions": "^4.4.2",
    "@gltf-transform/functions": "^4.4.2",
    "@maxigarcia/eslint-config": "^1.14.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "draco3dgltf": "^1.5.7",
    "eslint-plugin-astro": "^3.1.0",
    "eslint-plugin-react-refresh": "^0.5.5",
    "husky": "^9.1.7",
    "meshoptimizer": "^1.2.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "vitest": "^4.1.10"
  }
}
