---
import { bugs, homepage, version } from '@root/package.json';
import GithubIcon from '@/components/github-icon.astro';

const repoUrl = homepage.replace(/#readme$/, '');
---

<footer
  class="font-mono text-foreground-muted p-4 flex flex-row flex-wrap items-center justify-center gap-4 border-t border-surface-border/80 text-xs tracking-[0.2em] uppercase"
>
  <span aria-label={`Version ${version}`}>v{version}</span>
  &ndash;
  <a
    href={repoUrl}
    class="hover:text-accent focus-visible:outline-accent inline-flex items-center gap-2 underline-offset-4 motion-safe:transition-colors hover:underline focus-visible:outline-2 focus-visible:outline-offset-4"
    target="_blank"
    rel="noopener noreferrer"
  >
    <GithubIcon class="size-4 shrink-0" />
    Contribute on GitHub
  </a>
  &ndash;
  <a
    href={bugs.url}
    class="hover:text-accent focus-visible:outline-accent underline-offset-4 motion-safe:transition-colors hover:underline focus-visible:outline-2 focus-visible:outline-offset-4"
  >
    Bugs & Feedback
  </a>
  &ndash;
  <a
    href="/roadmap"
    class="hover:text-accent focus-visible:outline-accent underline-offset-4 motion-safe:transition-colors hover:underline focus-visible:outline-2 focus-visible:outline-offset-4"
  >
    Roadmap
  </a>
  &ndash;
  <a
    href="/third-party-assets"
    class="hover:text-accent focus-visible:outline-accent underline-offset-4 motion-safe:transition-colors hover:underline focus-visible:outline-2 focus-visible:outline-offset-4"
  >
    Third-Party Assets
  </a>
</footer>
